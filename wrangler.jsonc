{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rsvp-reader",
  "compatibility_date": "2026-10-01",
  // Static site only: no Worker script. Books never leave the browser.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "reader.shadster.dev", "custom_domain": true }],
  "workers_dev": false
}
